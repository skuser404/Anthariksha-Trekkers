# Anthariksha Trekkers — environment variables
# Copy this file to `.env` and fill in real values. DO NOT commit `.env`.

# Supabase (Project Settings → API)
# NEVER put real values in this file — it is committed to a PUBLIC repo.
# Real values go in `.env` only (git-ignored).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE

# When these are missing, the site runs in static-only mode (no DB / no admin).
# That's safe — production marketing pages keep working with the bundled data.
